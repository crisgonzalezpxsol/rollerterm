{
  "name": "rollerterm",
  "version": "0.1.0",
  "private": true,
  "description": "Terminal de escritorio con pestañas con nombre, una por ticket o funcionalidad.",
  "main": "dist/main.js",
  "scripts": {
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper 2>/dev/null; electron-rebuild -f -w node-pty && sh scripts/brand-electron.sh",
    "dev": "node app/build-frontend.mjs && cargo run --release --manifest-path app/src-tauri/Cargo.toml",
    "start": "npm run dev",
    "build": "node app/build-frontend.mjs && cargo build --release --manifest-path app/src-tauri/Cargo.toml",
    "install-app": "npm run build && sh app/install.sh",
    "typecheck": "tsc --noEmit && tsc --noEmit -p app",
    "icon": "npx electron scripts/render-icon.cjs",
    "electron:build": "node build.mjs",
    "electron:dev": "node build.mjs && electron .",
    "electron:dist": "node build.mjs && electron-builder --mac dir && codesign --force --deep --sign - out/mac-*/rollerterm.app",
    "electron:install": "npm run electron:dist && rm -rf /Applications/rollerterm.app && ditto out/mac-*/rollerterm.app /Applications/rollerterm.app",
    "electron:dist:linux": "node build.mjs && electron-builder --linux dir",
    "electron:install-linux": "npm run electron:dist:linux && sh scripts/install-linux.sh"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/node": "^24.19.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "build": {
    "appId": "com.pxsol.rollerterm",
    "productName": "rollerterm",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": false,
    "npmRebuild": true,
    "mac": {
      "target": "dir",
      "icon": "assets/icon.icns",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "rollerterm abre enlaces y apps.",
        "NSMicrophoneUsageDescription": "Las apps que corrés en la terminal pueden pedir el micrófono."
      }
    },
    "linux": {
      "target": "dir",
      "icon": "assets/icon.png",
      "category": "Development",
      "executableName": "rollerterm"
    }
  }
}
