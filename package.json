{
  "name": "rollerterm",
  "version": "0.1.0",
  "private": true,
  "description": "Terminal de escritorio con pestañas con nombre, una por ticket o funcionalidad.",
  "main": "dist/main.js",
  "scripts": {
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper 2>/dev/null; electron-rebuild -f -w node-pty",
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "dev": "node build.mjs && electron .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/node": "^24.19.2",
    "electron": "^44.7.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  }
}
